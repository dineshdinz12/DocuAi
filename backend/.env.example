# Serverless Cloud LLM & Embeddings
GROQ_API_KEY=your_groq_api_key_here
HF_TOKEN=your_huggingface_token_here
MAIN_LLM_MODEL=llama-3.1-8b-instant

# Vector Database (Qdrant Cloud)
QDRANT_HOST=https://your-cluster-id.eu-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_cloud_api_key

# MinIO / S3 Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents

# Authentication Integration Credentials (Optional Production APIs)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
RESEND_API_KEY=re_your_resend_api_key
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15550000000
