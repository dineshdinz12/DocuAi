APP_ENV=development
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=25

# Use Groq in hosted environments. For local Ollama, set USE_LOCAL_LLM=true.
USE_LOCAL_LLM=false
GROQ_API_KEY=
MAIN_LLM_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# The backend image contains the local embedding model.
# Vector search
QDRANT_HOST=http://localhost:6333
QDRANT_PORT=6333
QDRANT_API_KEY=

# Supabase server credentials. Never expose the service key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# S3-compatible object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
